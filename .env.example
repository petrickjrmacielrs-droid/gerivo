NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibilidade com projetos que usam o nome antigo:
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: o Gerivo funciona com motor local sem estas variáveis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Modelo opcional para importar orçamentos Mobato/NBS por PDF ou imagem
OPENAI_IMPORT_MODEL=gpt-5-mini
